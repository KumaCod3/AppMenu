<!-- Page Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
	<div>
		<div class="flex items-center gap-3 mb-2">
			<a href="/menu"
				class="p-2 bg-white rounded-full shadow-subtle text-primary hover:bg-primary hover:text-white transition-all">
				<i data-lucide="chevron-left" class="w-5 h-5"></i>
			</a>
			<h1 class="text-3xl font-bold text-neutral-text">Piano Settimanale</h1>
		</div>
		<p id="intestazione" class="text-neutral-secondary font-medium">
			<span class="inline-flex items-center gap-2 bg-primary/10 text-primary px-3 py-1 rounded-full text-xs">
				<i data-lucide="calendar" class="w-3 h-3"></i>
				<span id="menu-name-label">Caricamento...</span>
			</span>
		</p>
	</div>

	<div class="flex flex-wrap gap-3">
		<div class="bg-white p-1 rounded-custom shadow-subtle border border-gray-100 flex gap-1">
			<button id="genMENU"
				class="p-2 hover:bg-primary/10 text-neutral-secondary hover:text-primary rounded-lg transition-all"
				title="Genera Auto">
				<i data-lucide="sparkles" class="w-5 h-5"></i>
			</button>
			<button id="LoadMenu"
				class="p-2 hover:bg-primary/10 text-neutral-secondary hover:text-primary rounded-lg transition-all"
				title="Carica file">
				<i data-lucide="file-up" class="w-5 h-5"></i>
			</button>
			<button id="Save"
				class="p-2 hover:bg-green-50 text-green-500 rounded-lg transition-all border border-transparent hover:border-green-100"
				title="Salva">
				<i data-lucide="save" class="w-5 h-5"></i>
			</button>
			<div class="w-px bg-gray-100 mx-1"></div>
			<button id="fresh" class="p-2 hover:bg-red-50 text-red-500 rounded-lg transition-all" title="Svuota">
				<i data-lucide="trash-2" class="w-5 h-5"></i>
			</button>
		</div>
	</div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
	<!-- Main Weekly Grid -->
	<div class="lg:col-span-8">
		<div id="contenitoreMenu" class="space-y-6">
			<!-- Rendered via JS -->
			<div class="flex flex-col items-center justify-center py-20 text-neutral-secondary opacity-50">
				<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mb-4"></div>
				<p>Preparando il tuo piano...</p>
			</div>
		</div>
	</div>

	<!-- Sidebar: Pitstop -->
	<div class="lg:col-span-4 lg:sticky lg:top-24 h-fit">
		<div class="bg-white rounded-custom shadow-subtle border border-gray-100 overflow-hidden">
			<div class="p-4 border-b border-gray-50 flex items-center justify-between bg-gray-50/50">
				<div class="flex items-center gap-2">
					<i data-lucide="shopping-bag" class="w-4 h-4 text-primary"></i>
					<h5 class="font-bold text-sm text-neutral-text uppercase tracking-wider">Ricette da Usare</h5>
					<div id="season-filter-indicator"
						class="flex items-center gap-1.5 ml-2 px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-tighter hidden">
						<!-- Loaded via JS -->
					</div>
				</div>
				<span class="bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full"
					id="counter-value">0</span>
			</div>
			<div class="p-4 bg-white">
				<div id="sidecar" data-map="-1"
					class="space-y-3 max-h-[calc(100vh-320px)] overflow-y-auto pr-2 custom-scrollbar">
					<!-- Sidebar Recipes -->
				</div>
			</div>
		</div>

		<div class="mt-6 p-4 bg-primary/5 rounded-custom border border-primary/10 text-primary text-xs flex gap-3">
			<i data-lucide="info" class="w-5 h-5 shrink-0"></i>
			<p>Trascina le ricette dalla barra laterale ai giorni della settimana per pianificare i tuoi pasti.</p>
		</div>
	</div>
</div>

<!-- Modal for Recipe Details (Slide-over approach) -->
<div id="recipeModal" class="fixed inset-0 z-50 hidden transition-all duration-300">
	<div class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity" onclick="hideModal('recipeModal')">
	</div>
	<div class="absolute right-0 top-0 h-full w-full max-w-2xl bg-white shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300"
		id="recipeModalContainer">
		<div class="p-4 border-b border-gray-100 flex items-center justify-between bg-white sticky top-0 z-10">
			<h2 class="text-lg font-bold text-neutral-text flex items-center gap-2">
				<i data-lucide="chef-hat" class="text-primary"></i>
				Dettagli Ricetta
			</h2>
			<button onclick="hideModal('recipeModal')" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
				<i data-lucide="x"></i>
			</button>
		</div>
		<div class="flex-1 overflow-hidden">
			<iframe id="recipe-iframe" src="about:blank" class="w-full h-full border-0"></iframe>
		</div>
	</div>
</div>

<style>
	.drag-over {
		@apply ring-4 ring-primary/20 bg-primary/5 border-primary border-dashed !important;
	}

	/* Global Reset for tags - ensuring no overrides */
	/* --- BULLETPROOF RECIPE TAGS --- */
	.badge-recipe-container {
		display: flex !important;
		align-items: center !important;
		overflow: hidden !important;
		border-radius: 999px !important;
		border: 1px solid !important;
		height: 34px !important;
		width: 100% !important;
		margin-bottom: 4px !important;
		transition: all 0.2s ease !important;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
	}

	.drag-handle {
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		cursor: grab !important;
		height: 100% !important;
		padding: 0 10px !important;
		min-width: 32px !important;
		border-right: 1px solid rgba(0, 0, 0, 0.1) !important;
	}

	.drag-handle:active {
		cursor: grabbing !important;
	}

	/* Colors - Teal (Pranzo) */
	.ricetta-pranzo {
		background-color: #f0fdfa !important;
		border-color: #99f6e4 !important;
		color: #0d9488 !important;
	}

	.ricetta-pranzo .drag-handle {
		background-color: #ccfbf1 !important;
	}

	/* Colors - Purple (Cena) */
	.ricetta-cena {
		background-color: #faf5ff !important;
		border-color: #e9d5ff !important;
		color: #7e22ce !important;
	}

	.ricetta-cena .drag-handle {
		background-color: #f3e8ff !important;
	}

	/* Colors - Pink (Testing) */
	.ricetta-testing {
		background-color: #fdf2f8 !important;
		border-color: #fbcfe8 !important;
		color: #be185d !important;
	}

	.ricetta-testing .drag-handle {
		background-color: #fce7f3 !important;
	}

	/* Colors - Neutral (Unisex) */
	.ricetta-unisex {
		background-color: #f8fafc !important;
		border-color: #e2e8f0 !important;
		color: #475569 !important;
	}

	.ricetta-unisex .drag-handle {
		background-color: #f1f5f9 !important;
	}

	.custom-scrollbar::-webkit-scrollbar {
		width: 4px;
	}

	.custom-scrollbar::-webkit-scrollbar-track {
		background: transparent;
	}

	.custom-scrollbar::-webkit-scrollbar-thumb {
		background: #e2e8f0;
		border-radius: 10px;
	}
</style>

<script>
	let titoloMenu = "";
	let questaSettimana = "";
	let idSettima = "";
	let idMenu = "";
	let stagioneMenu = 0;
	let sidecarCounter = 0;
	const counterSpan = document.getElementById("counter-value");
	const mappaRicette = new Map();
	let map = 0;

	function showModal(id) {
		const modal = document.getElementById(id);
		if (!modal) return;
		modal.classList.remove('hidden');
		const container = modal.querySelector('[id$="Container"]');
		if (container) {
			setTimeout(() => container.classList.remove('translate-x-full'), 10);
		}
	}
	function hideModal(id) {
		const modal = document.getElementById(id);
		if (!modal) return;
		const container = modal.querySelector('[id$="Container"]');
		if (container) {
			container.classList.add('translate-x-full');
		}
		setTimeout(() => {
			modal.classList.add('hidden');
			const iframe = document.getElementById('recipe-iframe');
			if (iframe) iframe.src = 'about:blank';
			caricaTavola(idSettima);
		}, 300);
	}

	document.addEventListener("DOMContentLoaded", () => {
		const url = window.location.pathname;
		const segments = url.split('/');
		idSettima = segments.pop();
		caricaTavola(idSettima);
		lucide.createIcons();
	});

	async function caricaTavola(idSettima) {
		try {
			const response = await fetch("/loadSettimana", {
				method: "POST",
				body: JSON.stringify({ iddi: idSettima }),
				headers: { "Content-Type": "application/json" }
			});
			if (response.ok) {
				const settimana = await response.json();
				idMenu = settimana.Menu;
				questaSettimana = settimana;

				// Get menu name
				const menuRes = await fetch("/MenuID", {
					method: "POST",
					body: JSON.stringify({ id: idMenu }),
					headers: { "Content-Type": "application/json" }
				});
				const menuData = await menuRes.json();
				titoloMenu = menuData.Name;
				stagioneMenu = menuData.Temperatura || 0;

				const label = document.getElementById("menu-name-label");
				label.textContent = `${titoloMenu} • ${settimana.Name}`;

				// Update season indicator
				const seasonInd = document.getElementById("season-filter-indicator");
				if (stagioneMenu === 1) {
					seasonInd.innerHTML = `<i data-lucide="sun" class="w-3 h-3"></i> Filtro Estivo`;
					seasonInd.className = "flex items-center gap-1.5 ml-2 px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-tighter bg-yellow-100 text-yellow-700";
					seasonInd.classList.remove("hidden");
				} else if (stagioneMenu === 2) {
					seasonInd.innerHTML = `<i data-lucide="snowflake" class="w-3 h-3"></i> Filtro Invernale`;
					seasonInd.className = "flex items-center gap-1.5 ml-2 px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-tighter bg-blue-100 text-blue-700";
					seasonInd.classList.remove("hidden");
				}

				caricaPitStop();
				renderWeeklyGrid(settimana);
			}
		} catch (err) { console.error(err); }
	}

	async function caricaPitStop() {
		try {
			const response = await fetch("/PitstopID", {
				method: "POST",
				body: JSON.stringify({ id: idMenu }),
				headers: { "Content-Type": "application/json" }
			});
			if (response.ok) {
				const data = await response.json();

				// FILTERING LOGIC
				// stagioneMenu: 1=Estate, 2=Inverno
				// ricetta.Temperatura: 1=Estate, 2=Inverno, 3=Entrambe, 0=Non definita
				const filteredRecipes = data.filter(ricetta => {
					const temp = ricetta.Temperatura || 0;
					if (stagioneMenu === 1) { // Menu Estivo: mostra 1, 3, 0
						return temp === 1 || temp === 3 || temp === 0;
					} else if (stagioneMenu === 2) { // Menu Invernale: mostra 2, 3, 0
						return temp === 2 || temp === 3 || temp === 0;
					}
					return true; // Se non c'è filtro menu, mostra tutto
				});

				sidecarCounter = filteredRecipes.length;
				counterSpan.textContent = sidecarCounter;

				const container = document.getElementById("sidecar");
				container.innerHTML = "";
				filteredRecipes.forEach(ricetta => {
					container.innerHTML += renderRecipeCell(ricetta, -1);
				});
				lucide.createIcons();
			}
		} catch (err) { console.error(err); }
	}

	function renderWeeklyGrid(settimana) {
		const container = document.getElementById("contenitoreMenu");
		container.innerHTML = "";
		map = 0;

		(settimana.Giorni || []).forEach(giorno => {
			const card = document.createElement('div');
			card.className = "bg-white rounded-custom shadow-subtle border border-gray-100 overflow-hidden";

			card.innerHTML = `
                <div class="px-6 py-4 bg-gray-50/50 border-b border-gray-50 flex items-center justify-between">
                    <h3 class="font-bold text-neutral-text">${giorno.Nome || 'Giorno'}</h3>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2">
                    <div class="p-6 border-b md:border-b-0 md:border-r border-gray-50 space-y-3">
                        <div class="flex items-center gap-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                            <i data-lucide="sun" class="w-3 h-3 text-yellow-500"></i> Pranzo
                        </div>
                        <div class="recipe-slot min-h-[60px] flex items-center justify-center border-2 border-dashed border-gray-100 rounded-xl transition-all" 
                             ondragover="allowDrop(event)" ondragleave="clearDropStyle(event)" ondrop="gestisciDropTabella(event)"
                             data-map="${map += 1}">
                            ${renderRecipeCell(giorno.Pranzo, map)}
                        </div>
                    </div>
                    <div class="p-6 space-y-3">
                        <div class="flex items-center gap-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                            <i data-lucide="moon" class="w-3 h-3 text-blue-500"></i> Cena
                        </div>
                        <div class="recipe-slot min-h-[60px] flex items-center justify-center border-2 border-dashed border-gray-100 rounded-xl transition-all" 
                             ondragover="allowDrop(event)" ondragleave="clearDropStyle(event)" ondrop="gestisciDropTabella(event)"
                             data-map="${map += 1}">
                            ${renderRecipeCell(giorno.Cena, map)}
                        </div>
                    </div>
                </div>
            `;
			container.appendChild(card);
		});
		lucide.createIcons();
	}

	function renderRecipeCell(ricetta, sourceMap) {
		if (!ricetta || !ricetta._id) return `<div class="text-xs text-gray-300 italic">Trascina qui...</div>`;

		const id = ricetta._id;
		const nome = ricetta.Name;
		const orario = ricetta.Orario || 0;
		const ora = Date.now();
		mappaRicette.set(id, ricetta);

		// Color coding priority: In Prova (Pink) > Lunch (Teal) / Dinner (Purple)
		let colorClass = 'ricetta-unisex';
		if (ricetta.Prova) {
			colorClass = 'ricetta-testing';
		} else if (orario == 1) {
			colorClass = 'ricetta-pranzo';
		} else if (orario == 2) {
			colorClass = 'ricetta-cena';
		}

		return `
            <div class="badge-recipe-container ${colorClass} w-full relative group" 
                 id="tabrecipe-${id}-${ora}" 
                 data-id="${id}" 
                 data-sourcemap="${sourceMap}"
                 draggable="true"
                 ondragstart="return iniziaDrag(event, '${id}', '${nome}', 'tabrecipe-${id}-${ora}', '${sourceMap}')">
                
                <div class="drag-handle shrink-0 flex items-center justify-center group-hover:bg-white/50 transition-colors"
                     onmousedown="window.canDrag = true"
                     onmouseup="window.canDrag = false">
                    <i data-lucide="grip-vertical" class="w-3.5 h-3.5 pointer-events-none opacity-50"></i>
                </div>
                
                <div class="flex-1 px-3 py-1.5 text-[13px] font-bold truncate cursor-pointer hover:underline decoration-2 underline-offset-2" 
                     onclick="apriModaleRicetta('${id}')" 
                     onmousedown="event.stopPropagation(); window.canDrag = false"
                     title="Clicca per i dettagli: ${nome}">
                    ${nome}
                    ${ricetta.Prova ? '<span class="ml-1 text-[10px]">🧪</span>' : ''}
                </div>
            </div>
        `;
	}

	// Drag & Drop Logic
	function allowDrop(e) { e.preventDefault(); e.currentTarget.classList.add("drag-over"); }
	function clearDropStyle(e) { e.currentTarget.classList.remove("drag-over"); }

	function iniziaDrag(e, id, nome, elementId, sourceMap) {
		// Only allow dragging if the handle was mousedown'd
		if (!window.canDrag) {
			e.preventDefault();
			return false;
		}

		const payload = { id: id, name: nome, oggetto: elementId, sourceMap: sourceMap };
		e.dataTransfer.setData("text/plain", JSON.stringify(payload));

		// Visual feedback
		setTimeout(() => {
			const el = document.getElementById(elementId);
			if (el) el.classList.add("opacity-40", "scale-95");
		}, 0);

		window.canDrag = false; // reset for next time
		return true;
	}

	function gestisciDropTabella(e) {
		e.preventDefault();
		const targetSlot = e.currentTarget;
		targetSlot.classList.remove("drag-over");

		const data = JSON.parse(e.dataTransfer.getData("text/plain"));
		const movedId = data.id;
		const movedRecipe = mappaRicette.get(movedId);
		const sourceMap = parseInt(data.sourceMap);
		const targetMap = parseInt(targetSlot.dataset.map);

		if (sourceMap === targetMap) {
			const origin = document.getElementById(data.oggetto);
			if (origin) origin.classList.remove("opacity-40", "scale-95");
			return;
		}

		// SWAP LOGIC
		const existingRecipeEl = targetSlot.querySelector('.badge-recipe-container');
		if (existingRecipeEl) {
			const existingId = existingRecipeEl.dataset.id;
			const existingRecipe = mappaRicette.get(existingId);

			if (sourceMap === -1) {
				// From Sidecar to full slot: swap back to sidecar
				liberaRicetta(existingRecipe._id);
				document.getElementById("sidecar").innerHTML += renderRecipeCell(existingRecipe, -1);
			} else {
				// From Slot to full slot: move existing to source slot
				const sourceSlot = document.querySelector(`.recipe-slot[data-map="${sourceMap}"]`);
				if (sourceSlot) {
					sourceSlot.innerHTML = renderRecipeCell(existingRecipe, sourceMap);
					updateInterno(existingId, sourceMap);
				}
			}
		} else {
			// Targeted empty: if came from a slot, clear that slot
			if (sourceMap !== -1) {
				const sourceSlot = document.querySelector(`.recipe-slot[data-map="${sourceMap}"]`);
				if (sourceSlot) {
					sourceSlot.innerHTML = `<div class="text-xs text-gray-300 italic">Trascina qui...</div>`;
					updateInterno(null, sourceMap);
				}
			}
		}

		// Update target UI and internal state
		targetSlot.innerHTML = renderRecipeCell(movedRecipe, targetMap);
		updateInterno(movedId, targetMap);

		// Handle data updates for sidecar movement
		if (sourceMap === -1) {
			occupaRicetta(movedId);
		}

		const origin = document.getElementById(data.oggetto);
		if (origin && sourceMap === -1) origin.remove(); // Only remove if it was physically in sidecar

		lucide.createIcons();
	}

	const sidecar = document.getElementById("sidecar");
	sidecar.ondragover = (e) => e.preventDefault();
	sidecar.ondrop = (e) => {
		e.preventDefault();
		const data = JSON.parse(e.dataTransfer.getData("text/plain"));
		const sourceMap = parseInt(data.sourceMap);

		if (sourceMap === -1) {
			const origin = document.getElementById(data.oggetto);
			if (origin) origin.classList.remove("opacity-40", "scale-95");
			return;
		}

		const movedId = data.id;
		const movedRecipe = mappaRicette.get(movedId);

		// Remove from slot
		const sourceSlot = document.querySelector(`.recipe-slot[data-map="${sourceMap}"]`);
		if (sourceSlot) {
			sourceSlot.innerHTML = `<div class="text-xs text-gray-300 italic">Trascina qui...</div>`;
			updateInterno(null, sourceMap);
		}

		// Add to sidecar
		sidecar.innerHTML += renderRecipeCell(movedRecipe, -1);
		liberaRicetta(movedId);

		const origin = document.getElementById(data.oggetto);
		if (origin) origin.remove();
		lucide.createIcons();
	};

	// Helper to update internal project state
	function updateInterno(recipeId, mapValue) {
		const idxGiorno = Math.floor((mapValue - 1) / 2);
		const tipoPasto = (mapValue % 2 !== 0) ? 'Pranzo' : 'Cena';
		const giorno = questaSettimana.Giorni[idxGiorno];
		if (giorno) {
			giorno[tipoPasto] = recipeId ? mappaRicette.get(recipeId) : null;
		}
	}

	// Original Integration Functions

	async function liberaRicetta(id) {
		try {
			const res = await fetch("/liberaRicetta", {
				method: "POST",
				body: JSON.stringify({ _id: id, _idMen: idMenu }),
				headers: { "Content-Type": "application/json" }
			});
			if (res.ok) { sidecarCounter++; counterSpan.textContent = sidecarCounter; }
		} catch (e) { }
	}

	async function occupaRicetta(id) {
		try {
			const res = await fetch("/occupaRicetta", {
				method: "POST",
				body: JSON.stringify({ _id: id, _idMen: idMenu }),
				headers: { "Content-Type": "application/json" }
			});
			if (res.ok) { sidecarCounter--; counterSpan.textContent = sidecarCounter; }
		} catch (e) { }
	}

	document.getElementById("Save").onclick = async () => {
		try {
			const res = await fetch("/salvaSettimana", {
				method: "POST",
				body: JSON.stringify(questaSettimana),
				headers: { "Content-Type": "application/json" }
			});
			if (res.ok) alert('Salvato!');
		} catch (e) { alert('Errore salvataggio'); }
	};

	document.getElementById("genMENU").onclick = async () => {
		try {
			const res = await fetch("/genSett", {
				method: "POST",
				body: JSON.stringify({ settimana: questaSettimana }),
				headers: { "Content-Type": "application/json" }
			});
			if (res.ok) caricaTavola(idSettima);
		} catch (e) { }
	};

	document.getElementById("fresh").onclick = async () => {
		if (!confirm("Vuoi svuotare tutto il piano?")) return;
		try {
			await fetch("/refreshRic", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
			caricaTavola(idSettima);
		} catch (e) { }
	};

	// Load from file (PowerShell/Text)
	const btnLoad = document.getElementById('LoadMenu');
	const fInput = document.createElement('input');
	fInput.type = 'file'; fInput.accept = '.txt';
	btnLoad.onclick = () => fInput.click();
	fInput.onchange = async (e) => {
		const file = e.target.files[0];
		if (!file) return;
		const text = await file.text();
		const lines = text.split('\n').map(r => r.trim()).filter(r => r !== "");
		let gArr = []; let gCurr = null;
		lines.forEach(l => {
			if (!isNaN(l)) { if (gCurr) gArr.push(gCurr); gCurr = { Pranzo: "", Cena: "" }; }
			else if (l.toLowerCase().startsWith("pranzo:")) gCurr.Pranzo = l.replace(/pranzo:/i, "").trim();
			else if (l.toLowerCase().startsWith("cena:")) gCurr.Cena = l.replace(/cena:/i, "").trim();
		});
		if (gCurr) gArr.push(gCurr);
		await fetch("/caricaSettimana", {
			method: "POST",
			body: JSON.stringify({ Giorni: gArr, idd: idSettima, menID: idMenu }),
			headers: { "Content-Type": "application/json" }
		});
		caricaTavola(idSettima);
	};

	function apriModaleRicetta(id) {
		const iframe = document.getElementById('recipe-iframe');
		iframe.src = `/ricetta/${id}?modal=true`;
		showModal('recipeModal');
	}
</script>